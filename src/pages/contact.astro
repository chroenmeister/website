---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact · Christoph Rönnecke" path="/contact/" description="Request a recording quote within 48 hours.">
  <section class="section">
    <div class="wrap prose">
      <h1>Contact</h1>
      <p>
        Email is enough. Include the checklist below and you receive a written offer within
        48 hours.
      </p>
      <div class="cta-row">
        <a class="btn btn--primary" href="mailto:info@roennecke.eu?subject=Recording%20enquiry">info@roennecke.eu</a>
        <a class="btn btn--ghost" href="tel:+4917624773361">+49 176 24773361</a>
      </div>

      <h2>What to include</h2>
      <ul class="checklist">
        <li><strong>Ensemble</strong> Name and instrumentation</li>
        <li><strong>Repertoire</strong> Programme or working title</li>
        <li><strong>Dates</strong> Preferred recording window</li>
        <li><strong>Venue</strong> Church, hall or still open</li>
        <li><strong>Planned release</strong> Label, self-release, broadcast, video</li>
      </ul>
    </div>
  </section>
</BaseLayout>
